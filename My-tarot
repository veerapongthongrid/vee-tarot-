            { name: "Knight of Wands", th: "อัศวินไม้เท้า", meaning: "เดินทางรวดเร็ว ใจร้อน กระตือรือร้น", img: "https://upload.wikimedia.org/wikipedia/commons/1/16/Wands12.jpg" },
            { name: "Queen of Wands", th: "ราชินีไม้เท้า", meaning: "ผู้หญิงมีเสน่ห์ มั่นใจ ผู้นำ ทำงานเก่ง รักอิสระ", img: "https://upload.wikimedia.org/wikipedia/commons/0/0d/Wands13.jpg" },
            { name: "King of Wands", th: "ราชาไม้เท้า", meaning: "ผู้ชายมีวิสัยทัศน์ นักธุรกิจ ผู้นำ เด็ดขาด", img: "https://upload.wikimedia.org/wikipedia/commons/c/ce/Wands14.jpg" },

            // --- Minor Arcana: Cups / ถ้วย (14 ใบ) ---
