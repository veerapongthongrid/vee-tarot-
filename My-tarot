            { name: "XIV. Temperance", th: "เทมเพอแรนซ์", meaning: "ความพอดี การปรับตัวเข้าหากัน การเยียวยา", img: "https://upload.wikimedia.org/wikipedia/commons/d/d0/Rider-Waite_Tarot_14_Temperance.jpg" },
